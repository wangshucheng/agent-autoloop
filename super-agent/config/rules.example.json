{
  "timezone": "Asia/Shanghai",
  "askFirst": ["删数据", "停服", "花钱", "对外发消息"],
  "sources": {
    "github": {
      "name": "GitHub",
      "adapter": "github"
    },
    "shop": {
      "name": "订单系统"
    },
    "cron": {
      "name": "定时"
    }
  },
  "agents": {
    "codex": {
      "name": "Codex",
      "worker": "dev-machine",
      "use": "codex",
      "access": "edit"
    },
    "reader": {
      "name": "只读巡检",
      "worker": "dev-machine",
      "use": "command",
      "access": "read",
      "command": ["codebuddy", "-p", "{prompt}"]
    },
    "dsh": {
      "name": "DeepSeek Harness",
      "worker": "dev-machine",
      "use": "dsh",
      "access": "edit"
    }
  },
  "channels": {
    "feishu": {
      "name": "飞书",
      "answerers": ["ou_xxx"],
      "links": false
    },
    "desktop": {
      "name": "桌面通知"
    }
  },
  "rules": [
    {
      "name": "每日早报",
      "when": {
        "cron": "0 8 * * *"
      },
      "to": "reader",
      "cwd": "~/notes",
      "skill": "morning-brief",
      "prompt": "整理昨天的笔记和提交，写今天的早报。",
      "tell": "needed"
    },
    {
      "name": "处理新 Issue",
      "when": {
        "source": "github",
        "types": ["issues.opened"]
      },
      "to": "codex",
      "cwd": "~/code/home-deco",
      "skill": "handle-issue",
      "parallel": 3,
      "tell": "needed",
      "emits": {
        "source": "github",
        "types": ["issue.triaged", "pr.opened"]
      }
    },
    {
      "name": "线上告警排查",
      "when": {
        "source": "shop",
        "types": ["alert.*"]
      },
      "to": "codex",
      "cwd": "~/code/shop",
      "skill": "run-ops",
      "parallel": 2,
      "tell": "needed"
    }
  ],
  "elsewhere": [
    {
      "name": "每周清理",
      "source": "shop",
      "to": "codex",
      "cron": "0 6 * * 0",
      "where": "调度器的定时任务"
    }
  ]
}
